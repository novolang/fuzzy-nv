        (0x1EF8, 0x1EF9), (0x1EFA, 0x1EFB), (0x1EFC, 0x1EFD), (0x1EFE, 0x1EFF)]

fn expected_lower(pairs: [(Int, Int)], cp: Int) -> Int
    for p in pairs
        if p.0 == cp
            return p.1
    cp

@test
fn test_the_case_mappings_agree_with_python_over_every_claimed_codepoint() [io]
    let pairs = python_pairs()
    test.case("424 pairs in the claimed ranges")
    test.assert(list.len(pairs) == 424)

    test.case("every codepoint of Latin-1 and Latin Extended-A lowers as Python lowers it")
    var wrong = 0
    for cp in 0..0x180
        if fuzzypat.simple_lower(cp) != expected_lower(pairs, cp)
            wrong = wrong + 1
    test.assert(wrong == 0)

    test.case("so does every basic Greek letter, the Cyrillic block and its supplement")
    for cp in 0x386..0x3AC
        if fuzzypat.simple_lower(cp) != expected_lower(pairs, cp)
            wrong = wrong + 1
    for cp in 0x400..0x530
        if fuzzypat.simple_lower(cp) != expected_lower(pairs, cp)
            wrong = wrong + 1
    test.assert(wrong == 0)

    test.case("and Latin Extended Additional, the Vietnamese letters among them")
    for cp in 0x1E00..0x1F00
        if fuzzypat.simple_lower(cp) != expected_lower(pairs, cp)
            wrong = wrong + 1
    test.assert(wrong == 0)

    test.case("a codepoint outside the ranges compares as itself")
    test.assert(fuzzypat.simple_lower(0x10A0) == 0x10A0)
    test.assert(not fuzzypat.chars_equal(0x10A0, 0x2D00, FuzzyCaseIgnore))

    test.case("so under ignore, Greek and Cyrillic compare across case")
    test.assert(fuzzypat.chars_equal(0x3A9, 0x3C9, FuzzyCaseIgnore))
    test.assert(fuzzypat.chars_equal(0x416, 0x436, FuzzyCaseIgnore))
