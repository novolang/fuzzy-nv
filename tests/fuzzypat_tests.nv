// fuzzypat_tests.nv — the query language, what it refuses, and the case
// rule.
//
// The specification for the syntax is the SEARCH SYNTAX table of
// `man fzf`, and the order the sigils are read in is fzf's `parseTerms`
// in `src/pattern.go`.  Where nucleo's parser differs, the case says
// which one this package follows.
//
// The case mappings are checked against Python's `str.lower`, over
// every codepoint of the ranges the module claims.

use std.test
use std.list
use fuzzypat

// The first atom of term `t`.
fn atom_of(p: fuzzypat.FuzzyPattern, t: Int) -> fuzzypat.FuzzyAtom
    let term = p.terms[t]
    let a = term.atoms[0]
    a

fn compiled(query: Str) -> fuzzypat.FuzzyPattern
    match fuzzypat.parse(query, FuzzyCaseSmart)
        Ok(p)  => p
        Err(e) =>
            test.assert(false)
            fuzzypat.literal("", FuzzyCaseSmart)

fn is_kind(a: fuzzypat.FuzzyAtom, want: Str) -> Bool
    let got = match a.kind
        FuzzyAtomFuzzy  => "fuzzy"
        FuzzyAtomExact  => "exact"
        FuzzyAtomPrefix => "prefix"
        FuzzyAtomSuffix => "suffix"
        FuzzyAtomEqual  => "equal"
    got == want

fn refusal_at(query: Str) -> Int
    match fuzzypat.parse(query, FuzzyCaseSmart)
        Ok(_)  => 0 - 1
        Err(e) => fuzzypat.error_at(e)

fn is_sigil_refusal(query: Str) -> Bool
    match fuzzypat.parse(query, FuzzyCaseSmart)
        Ok(_)  => false
        Err(e) =>
            match e
                FuzzyPatternDanglingSigil(_) => true
                _                            => false

@test
fn test_a_plain_needle_is_one_fuzzy_atom_and_cannot_fail() [io]
    let p = fuzzypat.literal("fzy", FuzzyCaseSmart)

    test.case("one term, one atom")
    test.assert(list.len(p.terms) == 1)
    test.assert(fuzzypat.atom_count(p) == 1)

    test.case("and it is a fuzzy atom, not an exact one")
    test.assert(is_kind(atom_of(p, 0), "fuzzy"))

    test.case("the query is kept as typed, so an interface can echo it")
    test.assert(p.source == "fzy")

    test.case("a literal pattern carries fzf's sigils as text")
    let l = fuzzypat.literal("^src !x", FuzzyCaseSmart)
    test.assert(atom_of(l, 0).needle == "^src !x")
    test.assert(not atom_of(l, 0).negated)

    test.case("an empty needle compiles to no terms")
    test.assert(list.len(fuzzypat.literal("", FuzzyCaseSmart).terms) == 0)

@test
fn test_the_extended_syntax_is_fzfs_table() [io]
    let p = compiled("sbtrkt 'wild ^music .mp3$ !fire")

    test.case("five terms, every one of which must match")
    test.assert(list.len(p.terms) == 5)

    test.case("a bare word is fuzzy")
    test.assert(is_kind(atom_of(p, 0), "fuzzy"))
    test.assert(atom_of(p, 0).needle == "sbtrkt")

    test.case("a leading quote is exact, and the quote is not part of the needle")
    test.assert(is_kind(atom_of(p, 1), "exact"))
    test.assert(atom_of(p, 1).needle == "wild")

    test.case("^ is a prefix")
    test.assert(is_kind(atom_of(p, 2), "prefix"))
    test.assert(atom_of(p, 2).needle == "music")

    test.case("$ is a suffix")
    test.assert(is_kind(atom_of(p, 3), "suffix"))
    test.assert(atom_of(p, 3).needle == ".mp3")

    test.case("! negates, and a negated word is literal, as in fzf's table")
    test.assert(atom_of(p, 4).negated)
    test.assert(is_kind(atom_of(p, 4), "exact"))
    test.assert(atom_of(p, 4).needle == "fire")

    test.case("^exact$ is the whole candidate: one atom, not two")
    let whole = compiled("^main.nv$")
    test.assert(fuzzypat.atom_count(whole) == 1)
    test.assert(is_kind(atom_of(whole, 0), "equal"))
    test.assert(atom_of(whole, 0).needle == "main.nv")

@test
fn test_negation_combines_with_every_other_sigil() [io]
    test.case("!' flips a negated atom back to fuzzy, fzf's inverse-fuzzy")
    let q = compiled("!'fire")
    test.assert(atom_of(q, 0).negated)
    test.assert(is_kind(atom_of(q, 0), "fuzzy"))

    test.case("!^ is a negated prefix")
    let pre = compiled("!^music")
    test.assert(atom_of(pre, 0).negated)
    test.assert(is_kind(atom_of(pre, 0), "prefix"))

    test.case("!...$ is a negated suffix")
    let suf = compiled("!.mp3$")
    test.assert(is_kind(atom_of(suf, 0), "suffix"))
    test.assert(atom_of(suf, 0).needle == ".mp3")

    test.case("a quote after a suffix anchor makes a plain substring, as fzf reads it")
    test.assert(is_kind(atom_of(compiled("'wild$"), 0), "exact"))

@test
fn test_alternation_is_inside_a_term_and_conjunction_is_between_them() [io]
    // Either extension, but not a thumbnail.
    let p = compiled("png | jpg !thumb")

    test.case("two terms")
    test.assert(list.len(p.terms) == 2)

    test.case("the first holds both alternatives")
    let first = p.terms[0]
    test.assert(list.len(first.atoms) == 2)
    let second_alt = first.atoms[1]
    test.assert(second_alt.needle == "jpg")

    test.case("the second is the negation, alone")
    let second = p.terms[1]
    test.assert(list.len(second.atoms) == 1)
    test.assert(atom_of(p, 1).negated)

    test.case("and atom_count counts every atom, negated ones included")
    test.assert(fuzzypat.atom_count(p) == 3)

    test.case("a chain of alternatives stays one term")
    let three = compiled("a | b | c")
    test.assert(list.len(three.terms) == 1)
    test.assert(fuzzypat.atom_count(three) == 3)

    test.case("a bar joined to a word is text, since only a bar standing alone is an alternation")
    let joined = compiled("a|b")
    test.assert(atom_of(joined, 0).needle == "a|b")

@test
fn test_a_backslash_keeps_a_space_inside_an_atom() [io]
    let p = compiled("foo\\ bar baz")

    test.case("two terms, the first holding a space")
    test.assert(list.len(p.terms) == 2)
    test.assert(atom_of(p, 0).needle == "foo bar")

    test.case("an escaped bar is text and not an alternation")
    let q = compiled("a \\ | b")
    test.assert(list.len(q.terms) == 3)

@test
fn test_every_refusal_names_a_byte_offset_in_the_query() [io]
    test.case("a bang with nothing after it")
    match fuzzypat.parse("src !", FuzzyCaseSmart)
        Ok(_)  => test.assert(false)
        Err(e) =>
            match e
                FuzzyPatternDanglingSigil(at) => test.assert(at == 4)
                _                             => test.assert(false)

    test.case("a quote, a caret and a dollar with nothing to apply to")
    test.assert(is_sigil_refusal("src '"))
    test.assert(refusal_at("src '") == 4)
    test.assert(is_sigil_refusal("^"))
    test.assert(is_sigil_refusal("$"))
    test.assert(is_sigil_refusal("!$"))
    test.assert(is_sigil_refusal("^$"))

    test.case("a bar with nothing on one side, which nucleo would take as text")
    match fuzzypat.parse("png |", FuzzyCaseSmart)
        Ok(_)  => test.assert(false)
        Err(e) =>
            match e
                FuzzyPatternDanglingAlternation(at) => test.assert(at == 4)
                _                                   => test.assert(false)

    test.case("a bar at the start, and two in a row")
    test.assert(refusal_at("| png") == 0)
    test.assert(refusal_at("a | | b") == 4)
    test.assert(not is_sigil_refusal("a | | b"))

    test.case("error_at reads the offset off either variant")
    test.assert(fuzzypat.error_at(FuzzyPatternDanglingSigil(9)) == 9)
    test.assert(fuzzypat.error_at(FuzzyPatternDanglingAlternation(3)) == 3)

    test.case("and the message names the offset")
    test.assert(FuzzyPatternDanglingSigil(4).message() ==
                "the search sigil at byte 4 has no text to apply to")
    test.assert(FuzzyPatternDanglingAlternation(2).message() ==
                "the `|` at byte 2 has no atom on one side")

@test
fn test_smart_case_is_decided_once_and_is_readable_afterwards() [io]
    test.case("an all-lower needle resolves to ignore")
    let lower = fuzzypat.literal("readme", FuzzyCaseSmart)
    match lower.effective_case
        FuzzyCaseIgnore => test.assert(true)
        _               => test.assert(false)

    test.case("one upper-case character resolves to respect")
    let upper = fuzzypat.literal("Readme", FuzzyCaseSmart)
    match upper.effective_case
        FuzzyCaseRespect => test.assert(true)
        _                => test.assert(false)

    test.case("the requested policy is kept too, so an interface can say which rule applied")
    match upper.requested_case
        FuzzyCaseSmart => test.assert(true)
        _              => test.assert(false)

    test.case("a policy that is not smart is kept as written")
    match fuzzypat.literal("Readme", FuzzyCaseIgnore).effective_case
        FuzzyCaseIgnore => test.assert(true)
        _               => test.assert(false)
    match compiled("readme").effective_case
        FuzzyCaseIgnore => test.assert(true)
        _               => test.assert(false)

    test.case("upper case is Unicode's, past ASCII")
    match fuzzypat.smart_case_of("\u{00C4}rger")
        FuzzyCaseRespect => test.assert(true)
        _                => test.assert(false)
    match fuzzypat.smart_case_of("\u{03A9}mega")
        FuzzyCaseRespect => test.assert(true)
        _                => test.assert(false)
    match fuzzypat.smart_case_of("\u{00E4}rger \u{1F600}")
        FuzzyCaseIgnore => test.assert(true)
        _               => test.assert(false)

@test
fn test_the_two_degenerate_patterns_are_named() [io]
    test.case("an empty query demands nothing")
    test.assert(fuzzypat.is_empty(fuzzypat.literal("", FuzzyCaseSmart)))

    test.case("and so does a query of spaces")
    test.assert(fuzzypat.is_empty(compiled("   ")))

    test.case("a query of nothing but negations is a filter with no score to give")
    let f = compiled("!test !vendor")
    test.assert(fuzzypat.is_filter_only(f))
    test.assert(not fuzzypat.is_empty(f))

    test.case("one with a positive atom is not, and neither is an empty one")
    test.assert(not fuzzypat.is_filter_only(compiled("src !test")))
    test.assert(not fuzzypat.is_filter_only(compiled("")))

@test
fn test_the_comparison_primitives() [io]
    test.case("under ignore, two cases of one letter are equal")
    test.assert(fuzzypat.chars_equal('A', 'a', FuzzyCaseIgnore))
    test.assert(fuzzypat.chars_equal('a', 'A', FuzzyCaseSmart))

    test.case("under respect they are not, and a codepoint always equals itself")
    test.assert(not fuzzypat.chars_equal('A', 'a', FuzzyCaseRespect))
    test.assert(fuzzypat.chars_equal('A', 'A', FuzzyCaseRespect))

    test.case("a letter, a separator and a symbol are three classes")
    test.assert(fuzzypat.char_class('a') == CLASS_WORD)
    test.assert(fuzzypat.char_class('7') == CLASS_WORD)
    test.assert(fuzzypat.char_class(0x3B1) == CLASS_WORD)
    test.assert(fuzzypat.char_class('/') == CLASS_SEPARATOR)
    test.assert(fuzzypat.char_class(' ') == CLASS_SEPARATOR)
    test.assert(fuzzypat.char_class('_') == CLASS_SEPARATOR)
    test.assert(fuzzypat.char_class('@') == CLASS_OTHER)

    test.case("a forward slash is a path separator everywhere")
    test.assert(fuzzypat.is_path_separator('/', false))

    test.case("a backslash is one only when the caller says the candidates are Windows paths")
    test.assert(not fuzzypat.is_path_separator('\\', false))
    test.assert(fuzzypat.is_path_separator('\\', true))

@test
fn test_utf8_is_decoded_a_codepoint_at_a_time() [io]
    let s = "a\u{00E9}\u{20AC}\u{1F600}"

    test.case("one, two, three and four bytes")
    test.assert(fuzzypat.codepoint_at(s, 0) == 'a')
    test.assert(fuzzypat.codepoint_at(s, 1) == 0xE9)
    test.assert(fuzzypat.codepoint_len(s, 1) == 2)
    test.assert(fuzzypat.codepoint_at(s, 3) == 0x20AC)
    test.assert(fuzzypat.codepoint_len(s, 3) == 3)
    test.assert(fuzzypat.codepoint_at(s, 6) == 0x1F600)
    test.assert(fuzzypat.codepoint_len(s, 6) == 4)

    test.case("a continuation byte on its own is walked as one byte")
    test.assert(fuzzypat.codepoint_len(s, 2) == 1)

    test.case("a lead byte whose sequence is cut short is one byte too")
    let cut = str.slice(s, 3, 4)
    test.assert(fuzzypat.codepoint_len(cut, 0) == 1)
    test.assert(fuzzypat.codepoint_at(cut, 0) == 0xE2)

    test.case("a byte that cannot start a sequence answers itself")
    test.assert(fuzzypat.sequence_length(0xF8) == 1)

// Every codepoint of the claimed ranges whose lowercase mapping is not
// itself, from Python 3's `str.lower` over Unicode 15.0.0.  U+0130 is the
// one entry Python maps to two codepoints; its simple mapping in
// UnicodeData.txt is U+0069.
fn python_pairs() -> [(Int, Int)]
    [
        (0x0041, 0x0061), (0x0042, 0x0062), (0x0043, 0x0063), (0x0044, 0x0064), (0x0045, 0x0065), (0x0046, 0x0066),
        (0x0047, 0x0067), (0x0048, 0x0068), (0x0049, 0x0069), (0x004A, 0x006A), (0x004B, 0x006B), (0x004C, 0x006C),
