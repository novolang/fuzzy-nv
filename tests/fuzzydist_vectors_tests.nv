// fuzzydist_vectors_tests.nv — the distances against an independent
// implementation, over two hundred generated pairs.
//
// `tools/gen_dist_vectors.py` computes every number below with the
// textbook algorithms, and the difflib ratio with Python's
// `difflib.SequenceMatcher`, and writes them into `vectors`.  The
// strings are drawn from `a`, `b`, `c` and a space, so repeats and
// transpositions are common.
//
// `ratio` is compared with difflib's answer the way its documentation
// states: equal when difflib's matching blocks form a longest common
// subsequence, never below it otherwise.

use std.test
use std.list
use fuzzydist

// One pair and its answers, read from a line of `vectors`: the two
// strings, then Levenshtein, OSA, Damerau, the longest common
// subsequence, Jaro, Jaro-Winkler, `ratio` and difflib's ratio, split by
// `|`.
struct Row
    a: Str
    b: Str
    lev: Int
    osa: Int
    dam: Int
    lcs: Int
    jaro: Float
    jw: Float
    ratio: Float
    difflib: Float

fn row_of(line: Str) -> Row
    let f = str.split(line, "|")
    Row { a: f[0], b: f[1], lev: int_of_string(f[2]), osa: int_of_string(f[3]),
          dam: int_of_string(f[4]), lcs: int_of_string(f[5]), jaro: float_of_string(f[6]),
          jw: float_of_string(f[7]), ratio: float_of_string(f[8]),
          difflib: float_of_string(f[9]) }

fn close(x: Float, y: Float) -> Bool
    x - y < 0.000000001 and y - x < 0.000000001

fn vectors() -> [Str]
