@test
fn test_every_distance_agrees_with_the_independent_implementation() [io]
    var rows: [Row] = []
    for line in vectors()
        list.push(rows, row_of(line))
    var wrong = 0
    var bounded_wrong = 0
    var difflib_equal = 0
    var difflib_above = 0
    for r in rows
        if fuzzydist.levenshtein(r.a, r.b) != r.lev
            wrong = wrong + 1
        if fuzzydist.osa(r.a, r.b) != r.osa or fuzzydist.damerau(r.a, r.b) != r.dam
            wrong = wrong + 1
        if fuzzydist.lcs_length(r.a, r.b) != r.lcs
            wrong = wrong + 1
        if fuzzydist.indel(r.a, r.b) != list.len(str.chars(r.a)) + list.len(str.chars(r.b)) - 2 * r.lcs
            wrong = wrong + 1
        if not close(fuzzydist.jaro(r.a, r.b), r.jaro) or not close(fuzzydist.jaro_winkler(r.a, r.b), r.jw)
            wrong = wrong + 1
        if not close(fuzzydist.ratio(r.a, r.b), r.ratio)
            wrong = wrong + 1
        for bound in 0..4
            let lw = fuzzydist.levenshtein_within(r.a, r.b, bound)
            let ow = fuzzydist.osa_within(r.a, r.b, bound)
            let lw_want = if r.lev <= bound
                Some(r.lev)
            else
                None
            let ow_want = if r.osa <= bound
                Some(r.osa)
            else
                None
            if lw != lw_want or ow != ow_want
                bounded_wrong = bounded_wrong + 1
        if close(r.ratio, r.difflib)
            difflib_equal = difflib_equal + 1
        else if r.difflib > r.ratio
            difflib_above = difflib_above + 1

    test.case("two hundred pairs")
    test.assert(list.len(rows) == 200)

    test.case("levenshtein, osa, damerau, lcs, indel, jaro, jaro-winkler and ratio all agree")
    test.assert(wrong == 0)

    test.case("the bounded forms answer the distance within the bound and None past it")
    test.assert(bounded_wrong == 0)

    test.case("difflib never finds more than the longest common subsequence")
    test.assert(difflib_above == 0)

    test.case("and agrees with ratio on most pairs")
    test.assert(difflib_equal > 150)
